{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "API_URL"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "cache": false
    }
  }
}
